# Gift Fundraiser - Environment Configuration
# Copy this file to .env.local for local development
# cp .env.example .env.local

# ===========================================
# SUPABASE CONFIGURATION (Required for cloud storage)
# ===========================================
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# BASE URL CONFIGURATION (Optional)
# ===========================================
# Controls the redirect URL for magic link authentication emails.
# Auto-detected based on NODE_ENV if not set:
#   - Development (npm run dev): http://localhost:3000
#   - Production (npm run build:prod): https://jb-oh.github.io/gift_fundraiser
#
# IMPORTANT: Both URLs must be added to Supabase Dashboard:
#   Authentication → URL Configuration → Redirect URLs
#   - http://localhost:3000/auth/callback
#   - https://jb-oh.github.io/gift_fundraiser/auth/callback
#
# To test production auth flow locally, uncomment:
# NEXT_PUBLIC_BASE_URL=https://jb-oh.github.io/gift_fundraiser

# ===========================================
# NOTES
# ===========================================
# - Without Supabase credentials, the app will fall back to localStorage
# - localStorage mode is good for local development but data is browser-only
# - For production deployment, set these as GitHub repository secrets
